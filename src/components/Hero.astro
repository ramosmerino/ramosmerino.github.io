<section
  id="hero"
  class="relative h-screen w-full flex items-center justify-center overflow-hidden"
>
  <canvas id="life-canvas" class="fixed inset-0 w-full h-full z-0"></canvas>

  <div class="container mx-auto px-4 text-center z-10 pointer-events-none">
    <h1
      class="text-5xl md:text-6xl lg:text-7xl font-bold uppercase tracking-wider"
    >
        <span class="line">Design</span> <span class="line font-serif italic lowercase mx-10">and</span> <span class="line">Data</span> <br/> <span class="line">Systems</span>
    </h1>
  </div>

  <a
    href="mailto:cristobalramosmerino@gmail.com"
    class="contact fixed bottom-8 right-8 z-20 px-6 py-3 pointer-events-auto"
  >
    Contacto
  </a>
</section>

<style>
  h1 {
    font-size: 15rem;
    text-align: left;
    line-height: 0.8;
    font-weight: 500;
    letter-spacing: -20px;
    font-variant-ligatures: common-ligatures discretionary-ligatures
      historical-ligatures contextual;
    text-transform: uppercase;
    filter: (100%);
  }

  .contact {
    background: none;
    color: var(--color-text);
    font-family: inherit;
    font-weight: 500;
    font-variant-ligatures: common-ligatures discretionary-ligatures
      historical-ligatures contextual;
    text-transform: uppercase;
    font-size: 0.875rem;
    text-decoration: none;
    border: none;
  }

  @media (max-width: 767px) {
    h1 {
      letter-spacing: -0.04em;
      white-space: nowrap;
    }

    h1 br {
      display: none;
    }

    h1 .line {
      display: block;
      width: fit-content;
      margin: 0;
    }
  }

  #hero {
    color: var(--color-text);
  }

  canvas {
    /* sin esto el navegador toma el arrastre como scroll y cancela pointermove */
    touch-action: none;
    image-rendering: pixelated;
    background-color: var(--color-bg);
    opacity: 0.4;
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#life-canvas")!;
  const ctx = canvas.getContext("2d");

  const rootStyle = getComputedStyle(document.documentElement);
  const bg = rootStyle.getPropertyValue("--color-bg").trim();
  const fg = rootStyle.getPropertyValue("--color-white").trim();
  let width: number,
    height: number,
    cols: number,
    rows: number,
    resolution: number,
    grid: any[], 
    next: any[],
    willDie: boolean[][],
    lastScrollY: number = window.scrollY;
  const fps = 24;
  const dimAlpha = 0.35;

  function init() {
    resolution = 5;
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
    cols = Math.floor(width / resolution);
    rows = Math.floor(height / resolution);

    grid = new Array(cols)
      .fill(0)
      .map((v, i) =>
        // {
        //   const paintCol = Math.floor(Math.random() * 2);
        //   return new Array(rows).fill(0).map(() => paintCol);
        // }
        new Array(rows).fill(0).map(() => 0)
      );
  }

  function glitch(x: number, y: number, size: any) {
    ctx.fillStyle = `rgba(${Math.random() * 255}, ${Math.random() * 255}, ${Math.random() * 255}, 0.2)`;
    ctx.fillRect(x, y, size, size);
  }

  let aliveCount = 0;

  function draw() {
    aliveCount = 0;
    ctx.clearRect(0, 0, width, height);
    ctx.globalAlpha = 1;
    for (let x = 0; x < cols; x++) {
      for (let y = 0; y < rows; y++) {
        if (grid[x][y] === 1) {
          aliveCount++;
          // Las celdas a punto de morir brillan más que el resto
          ctx.globalAlpha = willDie[x][y] ? 1 : dimAlpha;
          ctx.fillStyle = fg;
          ctx.fillRect(x * resolution, y * resolution, resolution, resolution);
          if (Math.random() > 0.95)
            glitch(x * resolution, y * resolution, resolution);
        } else {
          ctx.fillStyle = bg;
          }
      }
    }
  }

  // Audio: 6 osciladores en Fa lidio (F G A B C D E).
  // - 4 forman acordes de séptima (fundamental, 3ª, 5ª, 7ª sobre la escala).
  //   La pantalla se divide en 7 columnas invisibles, una por grado: la más
  //   aguda a la izquierda y la más grave a la derecha. Suena la columna con
  //   más celdas nacidas/sembradas en cada frame.
  // - 1 sigue al mouse según su posición y las celdas que siembra al moverse.
  // - 1 hace destellos agudos y breves ("estrellas", "perlas") que titilan en
  //   proporción a las celdas vivas y toman su nota de una celda viva al azar.
  // La altura (y) controla un filtro paso bajo: arriba pasa todo, abajo solo
  // graves.
  const lydian = [0, 2, 4, 6, 7, 9, 11]; // semitonos desde la tónica
  const rootFreq = 174.61; // F3
  const soundColumns = 7;
  const chordInterval = 0.18; // segundos mínimos entre acordes
  const minCutoff = 150;
  const maxCutoff = 9000;
  const sparkleOctaves = 3; // octavas sobre la fundamental (F6–E7)
  const sparkleStep = 0.05; // segundos entre destellos
  const sparkleLength = 0.045;
  const sparkleLevel = 0.025;
  const sparkleDensityGain = 20; // celdas vivas -> destellos por frame
  const sparkleMaxPerFrame = 3;

  let audioCtx: AudioContext | null = null;
  let master: GainNode | null = null;
  let chordFilter: BiquadFilterNode | null = null;
  let chordVoices: { osc: OscillatorNode; gain: GainNode }[] = [];
  let mouseVoice: { osc: OscillatorNode; gain: GainNode; filter: BiquadFilterNode } | null = null;
  let sparkleVoice: { osc: OscillatorNode; gain: GainNode } | null = null;
  let sparkleNext = 0; // instante en que puede sonar el próximo destello
  let lastChordTime = 0;

  const fadeSeconds = 5;
  const masterLevel = 0.5;
  let releaseTimer: number | undefined;

  function createVoice(ctx: AudioContext, destination: AudioNode) {
    const osc = ctx.createOscillator();
    osc.type = "sawtooth";
    const gain = ctx.createGain();
    gain.gain.value = 0;
    osc.connect(gain);
    gain.connect(destination);
    osc.start();
    return { osc, gain };
  }

  // Cada clic (re)inicia el sonido: volumen pleno y fade out lento de 5 s
  function enableAudio() {
    if (!audioCtx) {
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      if (!AC) return;
      audioCtx = new AC();
      const compressor = audioCtx.createDynamicsCompressor();
      master = audioCtx.createGain();
      master.connect(compressor);
      compressor.connect(audioCtx.destination);

      chordFilter = audioCtx.createBiquadFilter();
      chordFilter.type = "lowpass";
      chordFilter.connect(master);
      chordVoices = [0, 1, 2, 3].map(() => createVoice(audioCtx!, chordFilter!));

      const mouseFilter = audioCtx.createBiquadFilter();
      mouseFilter.type = "lowpass";
      mouseFilter.connect(master);
      mouseVoice = { ...createVoice(audioCtx, mouseFilter), filter: mouseFilter };
      sparkleVoice = createVoice(audioCtx, master);
      sparkleVoice.osc.type = "sine";
      sparkleNext = 0;
      lastChordTime = 0;
    }
    if (audioCtx.state === "suspended") audioCtx.resume();

    const t = audioCtx.currentTime;
    master!.gain.cancelScheduledValues(t);
    master!.gain.setValueAtTime(masterLevel, t);
    master!.gain.exponentialRampToValueAtTime(0.0001, t + fadeSeconds);

    clearTimeout(releaseTimer);
    releaseTimer = window.setTimeout(releaseAudio, fadeSeconds * 1000 + 100);
  }

  // Al terminar el fade se detienen los 5 osciladores y se cierra el contexto
  function releaseAudio() {
    [
      ...chordVoices,
      ...(mouseVoice ? [mouseVoice] : []),
      ...(sparkleVoice ? [sparkleVoice] : []),
    ].forEach(({ osc, gain }) => {
      try {
        osc.stop();
      } catch {}
      osc.disconnect();
      gain.disconnect();
    });
    chordVoices = [];
    mouseVoice = null;
    sparkleVoice = null;
    chordFilter = null;
    audioCtx?.close();
    audioCtx = null;
    master = null;
  }

  // Frecuencia del grado `index` de la escala (puede pasar de 6: sube de octava)
  function scaleFreq(index: number) {
    const semitones = lydian[index % lydian.length] + 12 * Math.floor(index / lydian.length);
    return rootFreq * Math.pow(2, semitones / 12);
  }

  // Columna de pantalla -> grado: izquierda = más agudo (E), derecha = más grave (F)
  function degreeForX(x: number) {
    const column = Math.min(soundColumns - 1, Math.floor((x / cols) * soundColumns));
    return soundColumns - 1 - column;
  }

  function cutoffForY(y: number) {
    const height = 1 - y / (rows - 1 || 1); // 1 arriba, 0 abajo
    return minCutoff * Math.pow(maxCutoff / minCutoff, height);
  }

  // Envolvente: ataque rápido y decaimiento suave
  function pluck(gain: GainNode, t: number, level: number, decay: number) {
    gain.gain.cancelScheduledValues(t);
    gain.gain.setTargetAtTime(level, t, 0.01);
    gain.gain.setTargetAtTime(0, t + 0.08, decay);
  }

  function playChord(degree: number, avgY: number, count: number) {
    if (!audioCtx || !chordFilter || audioCtx.state !== "running") return;
    const t = audioCtx.currentTime;
    if (t - lastChordTime < chordInterval) return;
    lastChordTime = t;

    chordFilter.frequency.setTargetAtTime(cutoffForY(avgY), t, 0.02);
    const level = 0.04 + 0.03 * Math.min(1, count / 40);
    // Séptima: grados d, d+2, d+4, d+6 de la escala
    chordVoices.forEach(({ osc, gain }, i) => {
      osc.frequency.setTargetAtTime(scaleFreq(degree + 2 * i), t, 0.01);
      pluck(gain, t, level, 0.18);
    });
  }

  // Voz del mouse: el tono sube con la altura del cursor, cuantizado a la
  // escala y repartido en 3 octavas (F4 abajo, F7 arriba); el mismo y abre el
  // filtro, y el volumen depende de cuántas celdas sembró el movimiento
  const mouseBaseDegree = lydian.length; // F4
  const mouseOctaves = 3;
  function playMouse(y: number, seeded: number) {
    if (!audioCtx || !mouseVoice || audioCtx.state !== "running") return;
    const t = audioCtx.currentTime;
    const height = 1 - y / (rows - 1 || 1); // 1 arriba, 0 abajo
    const degree = mouseBaseDegree + Math.round(height * lydian.length * mouseOctaves);
    mouseVoice.osc.frequency.setTargetAtTime(scaleFreq(degree), t, 0.01);
    mouseVoice.filter.frequency.setTargetAtTime(cutoffForY(y), t, 0.02);
    pluck(mouseVoice.gain, t, 0.03 + 0.03 * (seeded / 3), 0.12);
  }

  // Destellos agudos: cuantas más celdas vivas, más titilan. Cada uno toma la
  // columna (grado) de una celda viva al azar y se agenda en secuencia para que
  // no se solapen.
  function playSparkles() {
    if (!audioCtx || !sparkleVoice || audioCtx.state !== "running") return;
    const density = aliveCount / (cols * rows);
    const expected = Math.min(sparkleMaxPerFrame, density * sparkleDensityGain);
    const n = Math.floor(expected) + (Math.random() < expected % 1 ? 1 : 0);
    const t = audioCtx.currentTime;
    const { osc, gain } = sparkleVoice;
    sparkleNext = Math.max(sparkleNext, t);

    for (let i = 0; i < n && sparkleNext < t + 0.1; i++) {
      let x = -1;
      for (let tries = 0; tries < 30 && x < 0; tries++) {
        const cx = Math.floor(Math.random() * cols);
        const cy = Math.floor(Math.random() * rows);
        if (grid[cx][cy] === 1) x = cx;
      }
      if (x < 0) return;
      const ts = sparkleNext;
      osc.frequency.setValueAtTime(
        scaleFreq(degreeForX(x) + lydian.length * sparkleOctaves),
        ts
      );
      gain.gain.setValueAtTime(0.0001, ts);
      gain.gain.linearRampToValueAtTime(sparkleLevel, ts + 0.004);
      gain.gain.exponentialRampToValueAtTime(0.0001, ts + sparkleLength);
      sparkleNext += sparkleStep;
    }
  }

  // Actividad por frame (nacimientos + celdas sembradas) agrupada por columna
  const columnCount = new Array(soundColumns).fill(0);
  const columnYSum = new Array(soundColumns).fill(0);

  function queueSound(x: number, y: number) {
    const c = Math.min(soundColumns - 1, Math.floor((x / cols) * soundColumns));
    columnCount[c]++;
    columnYSum[c] += y;
  }

  function flushSounds() {
    let best = 0;
    for (let c = 1; c < soundColumns; c++) if (columnCount[c] > columnCount[best]) best = c;
    if (columnCount[best] > 0) {
      const mid = ((best + 0.5) / soundColumns) * cols;
      playChord(degreeForX(mid), columnYSum[best] / columnCount[best], columnCount[best]);
    }
    columnCount.fill(0);
    columnYSum.fill(0);
  }

  // Siembra una celda muerta; devuelve true si la sembró. Si no es silenciosa,
  // aporta al acorde del frame
  function seedCell(x: number, y: number, silent = false) {
    if (x < 0 || x >= cols || y < 0 || y >= rows || grid[x][y] === 1) return false;
    grid[x][y] = 1;
    if (!silent) queueSound(x, y);
    return true;
  }

  function update() {
    next = grid.map((arr: any) => [...arr]);
    willDie = grid.map((arr: any) => arr.map(() => false));

    for (let x = 0; x < cols; x++) {
      for (let y = 0; y < rows; y++) {
        const cell = grid[x][y];
        let neighbors = 0;

        for (let i = -1; i <= 1; i++) {
          for (let j = -1; j <= 1; j++) {
            if (i === 0 && j === 0) continue;
            const col = (x + i + cols) % cols;
            const row = (y + j + rows) % rows;
            neighbors += grid[col][row];
          }
        }

        if (cell === 1 && (neighbors < 2 || neighbors > 3)) {
          next[x][y] = 0;
          willDie[x][y] = true;
        } else if (cell === 0 && neighbors === 3) {
          next[x][y] = 1;
          queueSound(x, y);
        }
      }
    }
  }

  // Onda tipo gota: anillos concéntricos que siembran celdas desde el centro
  let rippleRadius = -1;
  const rippleSpeed = 1.5;
  const rippleRings = [0, 14, 28];

  function startRipple() {
    rippleRadius = 0;
  }

  function stepRipple() {
    if (rippleRadius < 0) return;
    const cx = cols / 2;
    const cy = rows / 2;
    const maxRadius = Math.hypot(cx, cy) + rippleRings[rippleRings.length - 1];

    rippleRings.forEach((offset, ring) => {
      const radius = rippleRadius - offset;
      if (radius <= 0) return;
      const density = 0.7 - ring * 0.15;
      const x0 = Math.max(0, Math.floor(cx - radius - 2));
      const x1 = Math.min(cols - 1, Math.ceil(cx + radius + 2));
      for (let x = x0; x <= x1; x++) {
        for (let y = 0; y < rows; y++) {
          const dist = Math.hypot(x - cx, y - cy);
          if (Math.abs(dist - radius) < 1.5 && Math.random() < density) seedCell(x, y);
        }
      }
    });

    rippleRadius += rippleSpeed;
    if (rippleRadius > maxRadius) rippleRadius = -1;
  }

  // Acelerómetro: los píxeles se desplazan con el movimiento del dispositivo
  const motionGain = 0.8; // celdas por m/s² de cambio en la aceleración
  const motionMaxStep = 6; // máximo de celdas por frame
  let motionEnabled = false;
  let lastAccel: { x: number; y: number } | null = null;
  let driftX = 0;
  let driftY = 0;

  function shiftGrid(dx: number, dy: number) {
    next = grid.map((col: number[], x: number) =>
      col.map(
        (_: number, y: number) =>
          grid[(((x - dx) % cols) + cols) % cols][(((y - dy) % rows) + rows) % rows]
      )
    );
    grid = next;
  }

  function handleMotion(event: DeviceMotionEvent) {
    const a = event.accelerationIncludingGravity;
    if (!a || a.x == null || a.y == null) return;
    // iOS reporta los ejes con signo opuesto al de Android
    const sign = typeof (DeviceMotionEvent as any).requestPermission === "function" ? -1 : 1;
    if (lastAccel) {
      driftX += -sign * (a.x - lastAccel.x) * motionGain;
      driftY += sign * (a.y - lastAccel.y) * motionGain;
    }
    lastAccel = { x: a.x, y: a.y };
  }

  function applyMotion() {
    const clamp = (v: number) => Math.max(-motionMaxStep, Math.min(motionMaxStep, v));
    const stepX = clamp(Math.trunc(driftX));
    const stepY = clamp(Math.trunc(driftY));
    if (stepX !== 0 || stepY !== 0) shiftGrid(stepX, stepY);
    driftX = (driftX - Math.trunc(driftX)) * 0.8;
    driftY = (driftY - Math.trunc(driftY)) * 0.8;
  }

  async function enableMotion() {
    if (motionEnabled || typeof DeviceMotionEvent === "undefined") return;
    const requestPermission = (DeviceMotionEvent as any).requestPermission;
    if (typeof requestPermission === "function") {
      try {
        // iOS exige pedir permiso dentro de un gesto del usuario
        if ((await requestPermission.call(DeviceMotionEvent)) !== "granted") return;
      } catch {
        return;
      }
    }
    motionEnabled = true;
    window.addEventListener("devicemotion", handleMotion);
  }

  function loop() {
    applyMotion();
    stepRipple();
    update();
    flushSounds();
    draw();
    playSparkles();
    grid = next;
    setTimeout(() => {
        loop();
    }, 1000 / fps);
  }

  function handleMouseMove(event: { clientX: number; clientY: number }) {
    const rect = canvas.getBoundingClientRect();
    const mouseX = event.clientX - rect.left;
    const mouseY = event.clientY - rect.top;

    const cellX = Math.floor(mouseX / resolution);
    const cellY = Math.floor(mouseY / resolution);

    if (cellX >= 0 && cellX < cols && cellY >= 0 && cellY < rows) {
      if(grid[cellX][cellY] === 1) {
        grid[cellX][cellY] = 0;
      }
      else {
        // Las celdas del mouse suenan por la voz propia del mouse, no por los acordes
        const seeded = [cellY, cellY + 1, cellY - 1].filter((y) =>
          seedCell(cellX, y, true)
        ).length;
        if (seeded > 0) playMouse(cellY, seeded);
      }
    }
  }

 

  function handleScroll() {
    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;
    const sign = delta > 0 ? 1 : -1;
    next = grid.map((arr: any) => [...arr]);
    for (let x = 0; x < cols; x++) {
      for (let y = 0; y < rows; y++) {
        if(grid[x][y] === 1) {
          const ty = y + sign;
          if (delta > 0 && ty >= 0 && ty < rows && next[x][ty] === 0) queueSound(x, ty);
          next[x][ty] = delta > 0 ? 1 : 0;
        }
      }
    }
    grid = next;
    lastScrollY = currentScrollY;
  }  

  function handleClick(event: { clientX: number; clientY: number }) {
    enableMotion();
    enableAudio();
    const rect = canvas.getBoundingClientRect();
    const mouseX = event.clientX - rect.left;
    const mouseY = event.clientY - rect.top;

    const cellX = Math.floor(mouseX / resolution);
    const cellY = Math.floor(mouseY / resolution);

    // El clic activa el audio pero sus celdas sembradas no suenan
    for (let i = 0; i < rows; i++) {
      seedCell(cellX, i, true);
      seedCell(cellX, i + 1, true);
      seedCell(cellX, i + 2, true);
    }
    for (let i = 0; i < cols; i++) {
      seedCell(i, cellY, true);
      seedCell(i + 2, cellY, true);
    }
  }

  // Móvil: cada palabra en su línea, con un tamaño que ocupa todo el ancho
  const heroTitle = document.querySelector<HTMLElement>("h1")!;
  const mobileQuery = window.matchMedia("(max-width: 767px)");

  const mobileScale = 0.9; // 10% más pequeño que el ancho completo

  function fitLines() {
    const lines = heroTitle.querySelectorAll<HTMLElement>(".line");
    if (!mobileQuery.matches) {
      lines.forEach((line) => line.style.removeProperty("font-size"));
      return;
    }
    const available = heroTitle.clientWidth;
    lines.forEach((line) => {
      line.style.fontSize = "100px";
      const measured = line.getBoundingClientRect().width;
      line.style.fontSize = `${(100 * available * mobileScale) / measured}px`;
    });
  }

  fitLines();
  document.fonts.ready.then(fitLines);
  window.addEventListener("resize", fitLines);

  if (
    typeof DeviceMotionEvent !== "undefined" &&
    typeof (DeviceMotionEvent as any).requestPermission !== "function"
  )
    enableMotion();

  init();
  startRipple();
  loop();
  window.addEventListener("resize", () => {
    init();
    startRipple();
  });
  // pointermove cubre mouse y dedo; arrastrar sobre el canvas hace de hover
  window.addEventListener("pointermove", handleMouseMove);
  window.addEventListener("click", handleClick);
  // En móvil el audio se desbloquea con el toque (iOS exige touchend; Android
  // acepta touchstart), así el primer arrastre ya puede sonar
  window.addEventListener("touchstart", enableAudio, { passive: true });
  window.addEventListener("touchend", enableAudio);
  window.addEventListener("scroll", handleScroll);
</script>
